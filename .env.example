# ============================================================
# Oralclin — variáveis de ambiente
# Local: copie este arquivo para .env.local e preencha.
# Vercel: Project → Settings → Environment Variables.
# ============================================================

# --- Acesso ao painel (/admin/login) -------------------------
# Segredo usado para assinar o cookie de sessão. Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# O login usa exclusivamente os usuários cadastrados no banco de dados.
# E-mail e senha NÃO ficam em variáveis de ambiente.

# --- Banco de dados (Supabase) -------------------------------
# URL do projeto Supabase. Pode ser a mesma URL pública do projeto.
NEXT_PUBLIC_SUPABASE_URL=

# Chave secreta server-side. NUNCA use em código client-side e nunca publique no Git.
# O projeto também aceita SUPABASE_SECRET_KEY como nome alternativo.
SUPABASE_SERVICE_ROLE_KEY=

# Local: sem Supabase configurado, os dados ficam em .data/oralclin-db.json.

# Dados de demonstração (pacientes, agenda, financeiro fictícios) na
# primeira inicialização do banco. Use "false" para começar vazio.
SEED_DEMO_DATA=false

# --- Site ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://oralclin.com.br
NEXT_PUBLIC_CLINIC_TIMEZONE=America/Sao_Paulo
